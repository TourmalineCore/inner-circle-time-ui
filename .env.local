# local run only: .dockerignore keeps this file out of the image, where the values come from the cluster config instead
# read by the Vite config. The rest of the local run config is in .devcontainer/devcontainer.json
# any key can be set for a single run instead, which wins: UI_PORT=3600 npm start

# AUTH_API_URL / AUTH_UI_URL are not used in this mode
# because a mock token is used in the local mode
# leave them unset here
# AUTH_API_URL=
# AUTH_UI_URL=

UI_PORT=3507
# a layout-ui started from its own repo: http://localhost:4500/layout
LAYOUT_UI_URL=http://localhost:6500
# an api started from its own repo: http://localhost:4507
API_URL=http://localhost:6507
